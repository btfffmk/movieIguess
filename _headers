# Cloudflare Pages headers — mirrors Firebase Hosting's defaults plus a few static-asset niceties.
# Previously hosted on Firebase; deploy target moved to Cloudflare Pages (project: nebula).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/src/new-ui/netflix-ui.css
  Cache-Control: public, max-age=86400, must-revalidate

/src/new-ui/netflix-ui.js
  Cache-Control: public, max-age=86400, must-revalidate
